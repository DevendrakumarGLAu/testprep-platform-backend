# Copy to .env and edit. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-string-of-32-plus-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# Production only (DJANGO_DEBUG=False):
# DJANGO_HTTPS=True            # redirect to HTTPS, secure cookies, HSTS
# DJANGO_BEHIND_PROXY=True     # trust X-Forwarded-Proto from your reverse proxy
# DJANGO_LOG_LEVEL=WARNING

# Database. Leave all of these unset locally to use SQLite. First match wins:
# 1) one URL:
# DATABASE_URL=postgres://user:password@host:5432/dbname
# 2) or separate values (Supabase: use the Session pooler host and user):
# POSTGRES_HOST=aws-0-<region>.pooler.supabase.com
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres.<project-ref>
# POSTGRES_PASSWORD=your-password-here

# Question images and test thumbnails. Leave these unset locally: pictures are then kept in the backend/media folder.
# On the live site (Render's disk is wiped on every deploy) set them to store pictures in Supabase Storage instead:
# SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# SUPABASE_S3_ACCESS_KEY_ID=...        # Supabase > Project Settings > Storage > S3 Connection > New access key
# SUPABASE_S3_SECRET_ACCESS_KEY=...
# SUPABASE_S3_REGION=ap-south-1        # the region of your Supabase project
# SUPABASE_BUCKET=question-images      # a PUBLIC bucket (optional, this is the default name)
# SUPABASE_PUBLIC_BASE=                # optional: your own domain in front of the bucket
# Then run:  python manage.py check_storage

# The Re-attempt button on student results. true (default) shows it; false hides it. Change it here or in Render, then restart.
REATTEMPT_ENABLED=true
