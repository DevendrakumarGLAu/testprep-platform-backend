# Copy to .env and edit. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-string-of-32-plus-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,https://testprep-platform-frontend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,https://testprep-platform-frontend.onrender.com
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432

# Production only (DJANGO_DEBUG=False):
# DJANGO_HTTPS=True            # redirect to HTTPS, secure cookies, HSTS
# DJANGO_BEHIND_PROXY=True     # trust X-Forwarded-Proto from your reverse proxy
# DJANGO_LOG_LEVEL=WARNING
